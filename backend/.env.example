# =====================================================================
# SVCE ERP Backend - Environment Variables
# Copy this file to ".env" and fill in your actual values.
# NEVER commit the real ".env" file to GitHub.
# =====================================================================

# Server
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------
# Hosted PostgreSQL (Neon / Render / Supabase)
# If DATABASE_URL is set, it takes precedence over DB_* variables.
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_SSL=true

# ---------------------------------------------------------------------
# Local PostgreSQL connection (used if DATABASE_URL is not set)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=svce_erp
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - the origin(s) allowed to call this API (comma separated or *)
# Use * during local development or for multi-client access
CORS_ORIGIN=*
